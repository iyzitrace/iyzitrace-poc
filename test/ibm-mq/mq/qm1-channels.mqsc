* QM1 only: payments travel to QM2 over a sender channel, as between a customer's queue managers.
DEFINE QLOCAL('QM2') USAGE(XMITQ) TRIGGER TRIGTYPE(FIRST) INITQ('SYSTEM.CHANNEL.INITQ') TRIGDATA('QM1.TO.QM2') REPLACE
DEFINE CHANNEL('QM1.TO.QM2') CHLTYPE(SDR) TRPTYPE(TCP) CONNAME('qm2(1414)') XMITQ('QM2') DISCINT(0) REPLACE
DEFINE QREMOTE('PAYMENT.REMOTE') RNAME('PAYMENT.REQUEST') RQMNAME('QM2') XMITQ('QM2') REPLACE
SET AUTHREC PROFILE('PAYMENT.REMOTE') PRINCIPAL('app') OBJTYPE(QUEUE) AUTHADD(PUT, INQ)
START CHANNEL('QM1.TO.QM2')
