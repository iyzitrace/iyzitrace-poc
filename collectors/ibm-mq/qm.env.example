# /etc/mq_otel/<QMNAME>.env, one file per queue manager, e.g. /etc/mq_otel/QM1.env.
# Read by mq_otel@<QMNAME>.service. Mode 0640, owner root:mqotel.

# The queue manager's name, exactly as MQ shows it.
IBMMQ_CONNECTION_QUEUEMANAGER=QM1

# Its address: host(port), in quotes.
IBMMQ_CONNECTION_CONNNAME='mq-host-01.example(1414)'

# The channel the monitoring user connects through (docs/07-ibm-mq.md, step 1).
IBMMQ_CONNECTION_CHANNEL=IYZI.MON.SVRCONN

# The read-only monitoring user, and the file that holds its password (mode 0600, owner mqotel).
IBMMQ_CONNECTION_USER=iyzmon
IBMMQ_CONNECTION_PASSWORDFILE=/etc/mq_otel/QM1.pw

# The queue manager's address as its applications reach it: the host name and port they use in
# their own connection. With it, IyziTrace links these metrics to the queue manager the
# applications' messages go to (docs/07-ibm-mq.md, step 4).
IBMMQ_CONNECTION_METADATATAGS=iyzitrace.service.address
IBMMQ_CONNECTION_METADATAVALUES=mq-host-01.example:1414
