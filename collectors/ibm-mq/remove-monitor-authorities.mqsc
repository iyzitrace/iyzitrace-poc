* Removes what monitor-authorities.mqsc and the monitoring channel added, for one queue manager.
* Run as an MQ administrator:
*   runmqsc QMNAME < remove-monitor-authorities.mqsc

DELETE AUTHREC OBJTYPE(QMGR) GROUP('iyzmon')
DELETE AUTHREC PROFILE('SYSTEM.ADMIN.COMMAND.QUEUE') OBJTYPE(QUEUE) GROUP('iyzmon')
DELETE AUTHREC PROFILE('SYSTEM.DEFAULT.MODEL.QUEUE') OBJTYPE(QUEUE) GROUP('iyzmon')
DELETE AUTHREC PROFILE('**') OBJTYPE(QUEUE) GROUP('iyzmon')
DELETE AUTHREC PROFILE('SYSTEM.ADMIN.CONFIG.EVENT') OBJTYPE(QUEUE) GROUP('iyzmon')
DELETE AUTHREC PROFILE('SYSTEM.ADMIN.PERFM.EVENT') OBJTYPE(QUEUE) GROUP('iyzmon')
DELETE AUTHREC PROFILE('SYSTEM.ADMIN.QMGR.EVENT') OBJTYPE(QUEUE) GROUP('iyzmon')
DELETE AUTHREC PROFILE('**') OBJTYPE(CHANNEL) GROUP('iyzmon')
DELETE AUTHREC PROFILE('**') OBJTYPE(CLNTCONN) GROUP('iyzmon')

SET CHLAUTH('IYZI.MON.SVRCONN') TYPE(ADDRESSMAP) ACTION(REMOVEALL)
STOP CHANNEL('IYZI.MON.SVRCONN') MODE(FORCE) STATUS(INACTIVE)
DELETE CHANNEL('IYZI.MON.SVRCONN')
