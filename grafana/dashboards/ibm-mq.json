{
  "uid": "iyzitrace-ibm-mq",
  "title": "IBM MQ",
  "description": "IBM MQ queue managers, queues, dead-letter queues and channels, from mq_otel (iyzitrace-poc docs/07-ibm-mq.md).",
  "tags": [
    "iyzitrace",
    "ibm-mq"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Department",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/IyziTrace Metrics/",
        "current": {},
        "hide": 0
      },
      {
        "name": "qmgr",
        "label": "Queue manager",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ibmmq_qmgr_status_ratio, qmgr)",
          "refId": "qmgr"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "queue",
        "label": "Queue",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ibmmq_queue_depth_ratio{qmgr=~\"$qmgr\"}, queue)",
          "refId": "queue"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "dlq",
        "label": "Dead-letter queue",
        "type": "textbox",
        "query": "SYSTEM.DEAD.LETTER.QUEUE",
        "current": {
          "text": "SYSTEM.DEAD.LETTER.QUEUE",
          "value": "SYSTEM.DEAD.LETTER.QUEUE"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Queue managers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Not running",
      "description": "Queue managers that report a status other than Running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(max by (qmgr) (last_over_time(ibmmq_qmgr_status_ratio{qmgr=~\"$qmgr\"}[90s])) != 2) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Not reporting",
      "description": "Queue managers seen in the last hour that send no metrics now: the queue manager, its listener or its mq_otel is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(max by (qmgr) (last_over_time(ibmmq_qmgr_status_ratio{qmgr=~\"$qmgr\"}[1h])) unless on (qmgr) last_over_time(ibmmq_qmgr_status_ratio{qmgr=~\"$qmgr\"}[90s])) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Channels not running",
      "description": "Channels between queue managers that are stopped, retrying or starting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(last_over_time(ibmmq_channel_status_squash_ratio{qmgr=~\"$qmgr\", type!=\"SVRCONN\"}[90s]) < 2) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Messages on dead-letter queues",
      "description": "Messages waiting on the dead-letter queue ($dlq) of the selected queue managers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(ibmmq_queue_depth_ratio{qmgr=~\"$qmgr\", queue=\"$dlq\"}) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Queue managers",
      "description": "One row per queue manager; a queue manager that stopped reporting in the last hour shows as Not reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (last_over_time(ibmmq_qmgr_status_ratio{qmgr=~\"$qmgr\"}[90s])) or max by (qmgr) (last_over_time(ibmmq_qmgr_status_ratio{qmgr=~\"$qmgr\"}[1h]) * 0)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (ibmmq_qmgr_command_server_status_ratio{qmgr=~\"$qmgr\"})",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (ibmmq_qmgr_channel_initiator_status_ratio{qmgr=~\"$qmgr\"})",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (ibmmq_qmgr_connection_count_ratio{qmgr=~\"$qmgr\"})",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (qmgr) (rate(ibmmq_qmgr_interval_mqput_mqput1_count_total{qmgr=~\"$qmgr\"}[5m]))",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (qmgr) (rate(ibmmq_qmgr_interval_destructive_get_count_total{qmgr=~\"$qmgr\"}[5m]))",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (ibmmq_queue_depth_ratio{qmgr=~\"$qmgr\", queue=\"$dlq\"})",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (ibmmq_qmgr_queue_manager_file_system_free_space_percentage_ratio{qmgr=~\"$qmgr\"})",
          "refId": "H",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr) (ibmmq_qmgr_mq_fdc_file_count_ratio{qmgr=~\"$qmgr\"})",
          "refId": "I",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "qmgr": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            },
            "renameByName": {
              "qmgr": "qmgr",
              "Value #A": "Status",
              "Value #B": "Command server",
              "Value #C": "Channel initiator",
              "Value #D": "Connections",
              "Value #E": "Puts /s",
              "Value #F": "Gets /s",
              "Value #G": "Dead-letter queue",
              "Value #H": "Data disk free",
              "Value #I": "FDC files"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Status",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Not reporting",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Starting",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Running",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Quiescing",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Standby",
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Command server"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Command server"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Stopped",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Starting",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Running",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Stopping",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Retrying",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Channel initiator"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Channel initiator"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Stopped",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Starting",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Running",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Stopping",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Retrying",
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Connections"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Connections"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Puts /s"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Puts /s"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gets /s"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Gets /s"
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dead-letter queue"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Dead-letter queue"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Data disk free"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Data disk free"
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "green",
                      "value": 20
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FDC files"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "FDC files"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Queues",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Queues",
      "description": "The selected queues, deepest first. Full = depth as a share of the queue's MAXDEPTH. Oldest message and last get need queue monitoring (MONQ) on the queue manager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr, queue) (ibmmq_queue_depth_ratio{qmgr=~\"$qmgr\", queue=~\"$queue\"})",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr, queue) (ibmmq_queue_depth_ratio{qmgr=~\"$qmgr\", queue=~\"$queue\"}) / max by (qmgr, queue) (ibmmq_queue_attribute_max_depth_ratio{qmgr=~\"$qmgr\", queue=~\"$queue\"}) * 100",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr, queue) (ibmmq_queue_oldest_message_age_ratio{qmgr=~\"$qmgr\", queue=~\"$queue\"})",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr, queue) (ibmmq_queue_time_since_get_ratio{qmgr=~\"$qmgr\", queue=~\"$queue\"})",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (qmgr, queue) (rate(ibmmq_queue_mqput_mqput1_count_total{qmgr=~\"$qmgr\", queue=~\"$queue\"}[5m]))",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (qmgr, queue) (rate(ibmmq_queue_mqget_count_total{qmgr=~\"$qmgr\", queue=~\"$queue\"}[5m]))",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (qmgr, queue) (ibmmq_queue_input_handles_ratio{qmgr=~\"$qmgr\", queue=~\"$queue\"})",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "qmgr": 0,
              "queue": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
            },
            "renameByName": {
              "qmgr": "qmgr",
              "queue": "queue",
              "Value #A": "Depth",
              "Value #B": "Full",
              "Value #C": "Oldest message",
              "Value #D": "Since last get",
              "Value #E": "Puts /s",
