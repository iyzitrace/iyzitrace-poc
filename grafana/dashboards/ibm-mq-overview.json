{
  "uid": "iyzitrace-ibm-mq",
  "title": "IBM MQ - Overview",
  "description": "Every queue manager at a glance: what needs attention now, status, deepest queues, oldest messages and channels. From OpenTelemetry's ibm-mq-metrics (iyzitrace-poc docs/07-ibm-mq.md).",
  "tags": [
    "iyzitrace",
    "ibm-mq"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ibm-mq"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "IBM MQ",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Department",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/IyziTrace Metrics/",
        "current": {},
        "hide": 0
      },
      {
        "name": "qmgr",
        "label": "Queue manager",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ibm_mq_manager_status_ratio, ibm_mq_queue_manager)",
          "refId": "qmgr"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "dlq",
        "label": "Dead-letter queue",
        "type": "textbox",
        "query": "SYSTEM.DEAD.LETTER.QUEUE",
        "current": {
          "text": "SYSTEM.DEAD.LETTER.QUEUE",
          "value": "SYSTEM.DEAD.LETTER.QUEUE"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Needs attention now",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Not running",
      "description": "Queue managers that report a status other than Running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count((max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) * on (ibm_mq_queue_manager) (max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_heartbeat_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) > 0)) != 2) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Not reporting",
      "description": "Seen in the last day, not reached now: the queue manager, its listener or the metrics container is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[1d])) unless on (ibm_mq_queue_manager) (max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_heartbeat_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) > 0)) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Channels not running",
      "description": "Channels between queue managers that report a status other than Running (retrying, binding, ...). A channel that is stopped or inactive is not reported by the metrics container: it drops out of this list instead of showing as stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(last_over_time(ibm_mq_status_ratio{ibm_mq_queue_manager=~\"$qmgr\", ibm_mq_channel_type!=\"server-connection\"}[2m]) != 3) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "On dead-letter queues",
      "description": "Messages waiting on the dead-letter queue ($dlq) of the selected queue managers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(ibm_mq_queue_depth{ibm_mq_queue_manager=~\"$qmgr\", messaging_destination_name=\"$dlq\"}) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Queues > 80% full",
      "description": "Queues whose depth is above 80% of their MAXDEPTH: puts fail when one is full.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(ibm_mq_queue_depth{ibm_mq_queue_manager=~\"$qmgr\"} / ibm_mq_max_queue_depth{ibm_mq_queue_manager=~\"$qmgr\"} > 0.8) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Messages > 5 min old",
      "description": "Queues, apart from the dead-letter queue, whose oldest message waits longer than 5 minutes: nobody reads them, or not fast enough.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(ibm_mq_oldest_msg_age_microseconds{ibm_mq_queue_manager=~\"$qmgr\", messaging_destination_name!=\"$dlq\"} > 300) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Queue managers",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Queue managers",
      "description": "One row per queue manager; click a name for its own dashboard. A queue manager that stopped sending metrics in the last day shows as Not reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) * on (ibm_mq_queue_manager) (max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_heartbeat_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) > 0) or max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[1d]) * 0)",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count by (ibm_mq_queue_manager) (last_over_time(ibm_mq_status_ratio{ibm_mq_queue_manager=~\"$qmgr\", ibm_mq_channel_type!=\"server-connection\"}[2m]) != 3) or max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[1d])) * 0",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager) (ibm_mq_queue_depth{ibm_mq_queue_manager=~\"$qmgr\", messaging_destination_name=\"$dlq\"}) or max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[1d])) * 0",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager) (ibm_mq_oldest_msg_age_microseconds{ibm_mq_queue_manager=~\"$qmgr\", messaging_destination_name!=\"$dlq\"})",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count by (ibm_mq_queue_manager) (ibm_mq_queue_depth{ibm_mq_queue_manager=~\"$qmgr\"})",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager) (ibm_mq_connection_count{ibm_mq_queue_manager=~\"$qmgr\"})",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager) (ibm_mq_queue_manager_uptime_seconds{ibm_mq_queue_manager=~\"$qmgr\"})",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ibm_mq_queue_manager": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            },
            "renameByName": {
              "Value #A": "Status",
              "Value #B": "Channels down",
              "Value #C": "Dead letters",
              "Value #D": "Oldest msg",
              "Value #E": "Queues",
              "Value #F": "Connections",
              "Value #G": "Uptime"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Status",
                "desc": false
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Not reporting",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "Starting",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Running",
                        "color": "green",
                        "index": 2
                      },
                      "3": {
                        "text": "Quiescing",
                        "color": "orange",
                        "index": 3
                      },
                      "4": {
                        "text": "Standby",
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Channels down"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dead letters"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest msg"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Queues"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Connections"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ibm_mq_queue_manager"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Queue manager"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Queue manager",
                    "url": "/d/iyzitrace-ibm-mq-qmgr/ibm-mq-queue-manager?var-ds=${ds}&var-qmgr=${__data.fields.ibm_mq_queue_manager}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "state-timeline",
      "title": "Status history",
      "description": "Each queue manager's status over the time range; red where it was down or sent nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) * on (ibm_mq_queue_manager) (max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_heartbeat_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[2m])) > 0) or max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=~\"$qmgr\"}[1d]) * 0)",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{ibm_mq_queue_manager}}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not reporting",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Starting",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Running",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "Quiescing",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Standby",
                  "color": "blue",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "orange",
