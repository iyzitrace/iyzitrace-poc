{
  "uid": "iyzitrace-ibm-mq-qmgr",
  "title": "IBM MQ - Queue manager",
  "description": "One queue manager: workload, resources, queues and channels.",
  "tags": [
    "iyzitrace",
    "ibm-mq"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ibm-mq"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "IBM MQ",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Department",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/IyziTrace Metrics/",
        "current": {},
        "hide": 0
      },
      {
        "name": "qmgr",
        "label": "Queue manager",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ibmmq_qmgr_status_ratio, qmgr)",
          "refId": "qmgr"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "dlq",
        "label": "Dead-letter queue",
        "type": "textbox",
        "query": "SYSTEM.DEAD.LETTER.QUEUE",
        "current": {
          "text": "SYSTEM.DEAD.LETTER.QUEUE",
          "value": "SYSTEM.DEAD.LETTER.QUEUE"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Status",
      "description": "The queue manager's status; Not reporting when mq_otel sends nothing for it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(last_over_time(ibmmq_qmgr_status_ratio{qmgr=\"$qmgr\"}[90s])) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not reporting",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Starting",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Running",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "Quiescing",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Standby",
                  "color": "blue",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the queue manager started.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_qmgr_uptime_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Connections",
      "description": "Open connections to the queue manager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_qmgr_connection_count_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Queues",
      "description": "Queues mq_otel monitors on this queue manager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(ibmmq_queue_depth_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Channels not running",
      "description": "Channels to and from other queue managers that are stopped, retrying or starting.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(last_over_time(ibmmq_channel_status_squash_ratio{qmgr=\"$qmgr\", type!=\"SVRCONN\"}[90s]) < 2) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Dead-letter queue",
      "description": "Messages on $dlq.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_queue_depth_ratio{qmgr=\"$qmgr\", queue=\"$dlq\"}) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Workload",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Messages put and got",
      "description": "Messages put and taken per second, all queues.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_interval_mqput_mqput1_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "put"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_interval_destructive_get_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "got"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Commits and rollbacks",
      "description": "Transactions committed and rolled back per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_commit_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "commit"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_rollback_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "rollback"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "title": "Failed calls and expired messages",
      "description": "MQ calls that failed, and messages that expired, per second. Failed gets are left out: a reader waiting on an empty queue counts as one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_failed_mqput_count_total{qmgr=\"$qmgr\"}[5m]) + rate(ibmmq_qmgr_failed_mqput1_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "failed put"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_failed_mqopen_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "C",
          "range": true,
          "instant": false,
          "legendFormat": "failed open"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_failed_mqconn_mqconnx_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "D",
          "range": true,
          "instant": false,
          "legendFormat": "failed connect"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(rate(ibmmq_qmgr_expired_message_count_total{qmgr=\"$qmgr\"}[5m]))",
          "refId": "E",
          "range": true,
          "instant": false,
          "legendFormat": "expired"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      }
    },
    {
      "type": "row",
      "title": "Resources",
      "collapsed": false,
      "panels": [],
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU used on the queue manager's host, user and system.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_qmgr_user_cpu_time_percentage_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "user"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_qmgr_system_cpu_time_percentage_ratio{qmgr=\"$qmgr\"})",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "system"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "description": "Memory the queue manager uses (estimate).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_qmgr_ram_total_estimate_for_queue_manager_bytes_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "queue manager"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Free disk space",
      "description": "Free space of the file systems the queue manager writes to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "min(ibmmq_qmgr_queue_manager_file_system_free_space_percentage_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "queue manager data"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "min(ibmmq_qmgr_mq_errors_file_system_free_space_percentage_ratio{qmgr=\"$qmgr\"})",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "error logs"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "transparent",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Recovery log",
      "description": "How long the queue manager waits for a recovery log write.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibmmq_qmgr_log_write_latency_seconds_ratio{qmgr=\"$qmgr\"})",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "write latency"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 14
      }
    },
    {
      "type": "row",
      "title": "Queues",
      "collapsed": false,
      "panels": [],
      "id": 16,
      "gridPos": {
        "h": 1,
