    {
      "type": "state-timeline",
      "title": "Channel status history",
      "description": "Each channel's status over the time range. A channel that is stopped or inactive is not reported by the metrics container: it drops out of this list instead of showing as stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_channel_name) (last_over_time(ibm_mq_status_ratio{ibm_mq_queue_manager=\"$qmgr\", ibm_mq_channel_type!=\"server-connection\"}[3m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "{{ibm_mq_channel_name}}"
