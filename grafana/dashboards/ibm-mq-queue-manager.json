{
  "uid": "iyzitrace-ibm-mq-qmgr",
  "title": "IBM MQ - Queue manager",
  "description": "One queue manager: its queues and channels.",
  "tags": [
    "iyzitrace",
    "ibm-mq"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ibm-mq"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "IBM MQ",
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Department",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/IyziTrace Metrics/",
        "current": {},
        "hide": 0
      },
      {
        "name": "qmgr",
        "label": "Queue manager",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(ibm_mq_manager_status_ratio, ibm_mq_queue_manager)",
          "refId": "qmgr"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "dlq",
        "label": "Dead-letter queue",
        "type": "textbox",
        "query": "SYSTEM.DEAD.LETTER.QUEUE",
        "current": {
          "text": "SYSTEM.DEAD.LETTER.QUEUE",
          "value": "SYSTEM.DEAD.LETTER.QUEUE"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Status",
      "description": "The queue manager's status; Not reporting when the metrics container sends nothing for it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_manager_status_ratio{ibm_mq_queue_manager=\"$qmgr\"}[3m])) * on (ibm_mq_queue_manager) (max by (ibm_mq_queue_manager) (last_over_time(ibm_mq_heartbeat_ratio{ibm_mq_queue_manager=\"$qmgr\"}[3m])) > 0)) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not reporting",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Starting",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "Running",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "Quiescing",
                  "color": "orange",
                  "index": 3
                },
                "4": {
                  "text": "Standby",
                  "color": "blue",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the queue manager started.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibm_mq_queue_manager_uptime_seconds{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Connections",
      "description": "Open connections to the queue manager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibm_mq_connection_count{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Queues",
      "description": "Queues monitored on this queue manager.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(ibm_mq_queue_depth{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Channels not running",
      "description": "Channels to and from other queue managers that report a status other than Running. A channel that is stopped or inactive is not reported by the metrics container: it drops out of this list instead of showing as stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count(last_over_time(ibm_mq_status_ratio{ibm_mq_queue_manager=\"$qmgr\", ibm_mq_channel_type!=\"server-connection\"}[3m]) != 3) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Dead-letter queue",
      "description": "Messages on $dlq.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max(ibm_mq_queue_depth{ibm_mq_queue_manager=\"$qmgr\", messaging_destination_name=\"$dlq\"}) or vector(0)",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      }
    },
    {
      "type": "row",
      "title": "Queues",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "table",
      "title": "Queues",
      "description": "Every monitored queue of this queue manager, deepest first; click one for its dashboard. Full = depth as a share of MAXDEPTH. Oldest message and time on queue need queue monitoring (MONQ).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_queue_depth{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_queue_depth{ibm_mq_queue_manager=\"$qmgr\"}) / max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_max_queue_depth{ibm_mq_queue_manager=\"$qmgr\"}) * 100",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_oldest_msg_age_microseconds{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_onqtime_short_period_microseconds{ibm_mq_queue_manager=\"$qmgr\"} >= 0) / 1e6",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_open_input_count{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, messaging_destination_name) (ibm_mq_open_output_count{ibm_mq_queue_manager=\"$qmgr\"})",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ibm_mq_queue_manager": 0,
              "messaging_destination_name": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "Value #A": "Depth",
              "Value #B": "Full",
              "Value #C": "Oldest message",
              "Value #D": "Time on queue",
              "Value #E": "Readers",
              "Value #F": "Writers"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Depth",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Depth"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Full"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oldest message"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time on queue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Readers"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Writers"
            },
            "properties": []
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ibm_mq_queue_manager"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Queue manager"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "messaging_destination_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Queue"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Queue",
                    "url": "/d/iyzitrace-ibm-mq-queue/ibm-mq-queue?var-ds=${ds}&var-qmgr=${__data.fields.ibm_mq_queue_manager}&var-queue=${__data.fields.messaging_destination_name}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "row",
      "title": "Channels",
      "collapsed": false,
      "panels": [],
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "table",
      "title": "Channels to and from other queue managers",
      "description": "Sender, receiver and cluster channels with their status. A channel that is stopped or inactive is not reported by the metrics container: it drops out of this list instead of showing as stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "max by (ibm_mq_queue_manager, ibm_mq_channel_name, ibm_mq_channel_type) (last_over_time(ibm_mq_status_ratio{ibm_mq_queue_manager=\"$qmgr\", ibm_mq_channel_type!=\"server-connection\"}[3m]))",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ibm_mq_queue_manager": 0,
              "ibm_mq_channel_name": 1,
              "ibm_mq_channel_type": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "Status"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Status",
                "desc": false
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Inactive",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "Binding",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Starting",
                        "color": "orange",
                        "index": 2
                      },
                      "3": {
                        "text": "Running",
                        "color": "green",
                        "index": 3
                      },
                      "4": {
                        "text": "Stopping",
                        "color": "orange",
                        "index": 4
                      },
                      "5": {
                        "text": "Retrying",
                        "color": "red",
                        "index": 5
                      },
                      "6": {
                        "text": "Stopped",
                        "color": "red",
                        "index": 6
                      },
                      "7": {
                        "text": "Requesting",
                        "color": "orange",
                        "index": 7
                      },
                      "8": {
                        "text": "Paused",
                        "color": "orange",
                        "index": 8
                      },
                      "9": {
                        "text": "Disconnected",
                        "color": "text",
                        "index": 9
                      },
                      "13": {
                        "text": "Initializing",
                        "color": "orange",
                        "index": 10
                      },
                      "14": {
                        "text": "Switching",
                        "color": "orange",
                        "index": 11
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ibm_mq_queue_manager"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Queue manager"
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ibm_mq_channel_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Channel"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ibm_mq_channel_type"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Type"
              }
            ]
          }
        ]
      },
      "id": 10,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "table",
      "title": "Application connections",
      "description": "Connections per server-connection channel.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "count by (ibm_mq_queue_manager, ibm_mq_channel_name) (last_over_time(ibm_mq_status_ratio{ibm_mq_queue_manager=\"$qmgr\", ibm_mq_channel_type=\"server-connection\"}[3m]))",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
